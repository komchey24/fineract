<html>
<head>
<meta charset="utf-8"/>
<style>
  /* Chromium fills in .pageNumber and .totalPages; the font size must be stated or it renders at ~1pt. */
  /* Chromium sizes the footer body to the full page width; adding a margin on top of width:100% pushes the
     right hand side off the page, so pad inside the box instead. */
  body {
    font-family: "Noto Sans Khmer", "Khmer OS Battambang", "Noto Sans", "DejaVu Sans", sans-serif;
    font-size: 7pt;
    color: #666;
    margin: 0;
    padding: 0 0.25in;
    box-sizing: border-box;
  }
  .bar { display: flex; justify-content: space-between; width: 100%; }
</style>
</head>
<body>
  <div class="bar">
    <span>{{reportName}}</span>
    <span><span class="pageNumber"></span> / <span class="totalPages"></span></span>
  </div>
</body>
</html>
