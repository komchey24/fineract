<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <!--
        'FullReportList' and 'ReportCategoryList' exist as stretchy_report rows purely so the reporting UI can list
        them; their real SQL lives in the stretchy_parameter rows of the same name and is reached via
        ?parameterType=true. The seed data stored the literal four-character string '(NULL)' in report_sql instead of
        a SQL NULL, so running either of them as a report executed '(NULL)' and failed with a database syntax error
        that the API surfaced as an opaque HTTP 403.

        Clearing report_sql makes the platform report them as not found, and clearing use_report stops them appearing
        as runnable reports in the first place.
    -->
    <changeSet author="fineract" id="clear-placeholder-report-sql-full-report-list">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="1">select count(1) from stretchy_report where report_name = 'FullReportList' and report_sql = '(NULL)'</sqlCheck>
        </preConditions>
        <update tableName="stretchy_report">
            <column name="report_sql" valueComputed="NULL"/>
            <column name="use_report" valueBoolean="false"/>
            <where>report_name = 'FullReportList'</where>
        </update>
        <rollback>
            <update tableName="stretchy_report">
                <column name="report_sql" value="(NULL)"/>
                <column name="use_report" valueBoolean="true"/>
                <where>report_name = 'FullReportList'</where>
            </update>
        </rollback>
    </changeSet>

    <changeSet author="fineract" id="clear-placeholder-report-sql-report-category-list">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="1">select count(1) from stretchy_report where report_name = 'ReportCategoryList' and report_sql = '(NULL)'</sqlCheck>
        </preConditions>
        <update tableName="stretchy_report">
            <column name="report_sql" valueComputed="NULL"/>
            <column name="use_report" valueBoolean="false"/>
            <where>report_name = 'ReportCategoryList'</where>
        </update>
        <rollback>
            <update tableName="stretchy_report">
                <column name="report_sql" value="(NULL)"/>
                <column name="use_report" valueBoolean="true"/>
                <where>report_name = 'ReportCategoryList'</where>
            </update>
        </rollback>
    </changeSet>

</databaseChangeLog>
